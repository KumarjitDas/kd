@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@KD_PROJECT_NAME_LOWER@-targets.cmake")

set(@KD_LIBRARY_NAME_UPPER@_VERSION_MAJOR @KD_VERSION_MAJOR@)
set(@KD_LIBRARY_NAME_UPPER@_VERSION_MINOR @KD_VERSION_MINOR@)
set(@KD_LIBRARY_NAME_UPPER@_VERSION_PATCH @KD_VERSION_PATCH@)
set(@KD_LIBRARY_NAME_UPPER@_VERSION @KD_VERSION@)

set_and_check(@KD_LIBRARY_NAME_UPPER@_LIB_DIR     "@PACKAGE_KD_INSTALL_LIB_DIR@")
set_and_check(@KD_LIBRARY_NAME_UPPER@_INCLUDE_DIR "@PACKAGE_KD_INSTALL_INCLUDE_DIR@")
set_and_check(@KD_LIBRARY_NAME_UPPER@_CMAKE_DIR   "${@KD_LIBRARY_NAME_UPPER@_LIB_DIR}/@KD_INSTALL_CMAKE_DIR@")

check_required_components(@KD_PROJECT_NAME@)
